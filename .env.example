# Beispielwerte für den Unterricht. Die echte .env steht in .gitignore.
RABBITMQ_USER=chat
RABBITMQ_PASSWORD=bitte-lokal-aendern

# Zugangsdaten der Chat-Datenbank. Der batch-writer ist der einzige
# Dienst, der hier schreibt.
POSTGRES_USER=chat
POSTGRES_PASSWORD=bitte-lokal-aendern
POSTGRES_DB=chat

# Live-Zustellung im chat-service. Die ersten beiden zusammen duerfen
# 1000 nicht ueberschreiten (Auftrag, Szenario S6): x-max-length zaehlt
# nur die "ready" Nachrichten, der Prefetch kommt obendrauf.
STREAM_QUEUE_MAX_LENGTH=950
STREAM_PREFETCH=50
STREAM_QUEUE_EXPIRES_MS=10000
